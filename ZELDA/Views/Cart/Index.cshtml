@using ZELDA.ViewModels

@model CartViewModel
@{
    ViewData["Title"] = "Checkout";
}

<section id="page-header" class="cart-header">
    <h2>#cart</h2>
    <p class="txt">Add your cupon code & save up to 70%!</p>
</section>


<section id="cart" class="section-p1">
    <table width="100%">

        <thead>
            <tr>
                <td>Remove</td>
                <td>Image</td>
                <td>Product</td>
                <td>Price</td>
                <td>Quantity</td>
                <td>Subtotal</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <a asp-action="Remove" asp-route-id="@item.ProductID">
                            <i class="fa-regular fa-circle-xmark"></i>
                        </a>
                    </td>

                    <td>
                        <img src="@item.ImageUrl" width="80" />
                    </td>

                    <td>@item.ProductName</td>

                    <td>@item.Price €</td>

                    <td>
                        <a asp-action="Decrease" asp-route-id="@item.ProductID">−</a>
                        @item.Quantity
                        <a asp-action="Increase" asp-route-id="@item.ProductID">+</a>
                    </td>

                    <td>@item.Total €</td>
                </tr>
            }
        </tbody>

    </table>

</section>

@if (User != null && User.Identity != null && User.Identity.IsAuthenticated && Model.Items.Count > 0)
{
    <section id="cart-add" class="section-p1">
        <div id="subtotal">
            <h3>Cart Totals</h3>

            <table>
                <tr>
                    <td>Cart Subtotal</td>
                    <td>@Model.GrandTotal €</td>
                </tr>

                <tr>
                    <td>Shipping</td>
                    <td>Free</td>
                </tr>

                <tr>
                    <td><strong>Total</strong></td>
                    <td><strong>@Model.GrandTotal €</strong></td>
                </tr>
            </table>

            <a asp-action="ConfirmCheckout" class="btn btn-primary checkOutBtn">Proceed to checkout</a>
        </div>
    </section>
}