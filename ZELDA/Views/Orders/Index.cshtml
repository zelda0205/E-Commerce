@model IEnumerable<ZELDA.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="view-orders-container">

    <div class="table-wrapper">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.User)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>

                    <th>Items</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => order.User.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => order.OrderDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => order.TotalAmount) €
                        </td>
                        <td>
                            @{
                                var first = true;
                            }
                            @foreach (var item in order.OrderItems)
                            {
                                if (!first)
                                {
                                    @: , 
                                }
                                @item.Product.Name
                                first = false;
                            }
                        </td>

                        <td>
                            <a asp-action="Delete" asp-route-id="@order.OrderID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>


