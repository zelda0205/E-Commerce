@model ZELDA.Models.Order

@{
    ViewData["Title"] = "Delete";
}

<div class="delete-news-letter-container">
    <h3>Are you sure you want to delete this order ?</h3>
    <div>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="TotalAmount" class="control-label"></label>
                    <input asp-for="TotalAmount" readonly disabled class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="User" class="control-label"></label>
                    <input asp-for="User" readonly disabled class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="OrderDate" class="control-label"></label>
                    <input asp-for="OrderDate" readonly disabled class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Order Items</label>

                    <input type="text"
                           value="@(Model.OrderItems != null && Model.OrderItems.Any()
                            ? string.Join(", ", Model.OrderItems.Select(p => $"{p.Product.Name} (x{p.Quantity})"))
                            : "No items")"
                           readonly
                           disabled
                           class="form-control" />
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="OrderID" />
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index">Back to List</a>
            </form>
        </div>
    </div>
</div>
