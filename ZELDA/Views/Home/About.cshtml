@{
    ViewData["Title"] = "About";
}

<section id="page-header" class="about-header banner-box">
    <h2>#Know Us</h2>
    <p class="txt">Zelda isn't just a shop. It's a movement. And you're invited!</p>
</section>

<section id="about-head" class="section-p1">
    <img src="../foto/about-2.jpg" alt="">
    <div>
        <h2>Who Are We? </h2>
        <p>
            Born from a love of slow fashion and soulful creativity,
            Zelda is a space where every item is crocheted with care — no machines,
            no shortcuts. Just yarn, hands, and heart. From cozy clothes to charming bags
            and accessories, each piece tells a story of patience, passion, and purpose.<br>
            We celebrate the beauty of individuality — no two stitches are ever quite the same,
            just like no two people are. When you wear Zelda, you carry a piece of art,
            a moment of stillness, and a whole lot of love.
        </p>

        <marquee bgcolor="#ad76cc" loop="-1" scrollamount="5" width="100%">
            Welcome to our handmade world.
            Welcome to Zelda.
        </marquee>
    </div>

</section>

<section id="about-2" class="section-p1">
    <h1>Crafted with care! Built to last! Made to stand out!</h1>
    <div class="vid">
        <video autoplay muted loop src="../foto/vid.mp4" width="600"></video>
        <audio id="bgMusic" src="../foto/sound-b.mp3" autoplay loop></audio>
    </div>
</section>

