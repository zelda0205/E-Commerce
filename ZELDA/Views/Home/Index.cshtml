@using ZELDA.ViewModels

@{
    ViewData["Title"] = "Home";
}

@model ProductAndCategoryViewModel

<!-- hero section-->
<section id="hero" class="hero-carousel heroReveal">
    <div class="slide slide1"></div>
    <div class="slide slide2"></div>
    <div class="slide slide3"></div>

    <div class="hero-content">
        <span id="firstText" class="tagline"></span>
        <h1>Woven by Hand</h1>
        <h2>Worn by Heart</h2>
        <p>A World Where Fashion Meets Soul</p>

        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="btn-primary">Shop Now</button>
        </form>
    </div>
</section>

<!--categorie section-->

<section id="product1" class="section-p1 featureProductsReveal">
    <h2>Categories</h2>
    <p>Find Your Style</p>

    <div class="pro-cotainer">
        @foreach (Category category in Model.Categories)
        {
            <div class="pro">
                <form method="post" asp-controller="Home" asp-action="FilterProducts">

                    <input type="hidden" name="category" value="@category.CategoryID" />

                    <img src="@GetCategoryImage(category.CategoryID)"
                         alt="@category.Name" />
                    <button type="submit" class="btn-primary">
                        Go to @category.Name
                    </button>
                </form>
            </div>
        }
    </div>
</section>

@functions {
    string GetCategoryImage(int categoryId)
    {
        return categoryId switch
        {
            1 => "/foto/clothes-f.webp",
            2 => "/foto/aksesor-f.png",
            3 => "/foto/bags-f.png",
            _ => "/foto/default.png"
        };
    }
}



<!--Featured Products-->
<section id="product1" class="section-p1 featureProductsReveal">
    <h2>Featured Products</h2>
    <p>Summer Collection New Modern Designs</p>
    <div class="pro-cotainer">
        @foreach (Product product in Model.Products)
        {
            <div class="pro">
                <img src="/ProductsImages/@product.Image" alt="Product Image">
                <div class="des">
                    <h5>@product.Name</h5>

                    <div class="shopping-cart-container">
                        <h4>@product.Price €</h4>
                        <a asp-controller="Cart"
                           asp-action="AddToCart"
                           asp-route-id="@product.ProductID"
                           class="cart-icon">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!--banners-->
<section id="sm-banner" class="section-p1 bannersReveal">
    <div class="banner-box">
        <h4>crazy deals</h4>
        <h2>buy 1 get 1 free</h2>
        <span> From cozy clothing to timeless bags and delicate accessories</span>
        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="white">Learn More</button>
        </form>
    </div>
    <div class="banner-box banner-box2">
        <h4>spring/summer</h4>
        <h2>upcoming season</h2>
        <span> a world where fashion meets soul ZELDA</span>
        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="white">Learn More</button>
        </form>

    </div>
</section>

<section id="newsletter" class="section-p1 newsletterReveal">
    <div class="newstext">
        <h4>Sign Up For Newsletters</h4>
        <p>Get E-mail updates about our latest shop and <span>special offers</span></p>
    </div>

    <form id="newsletter-form">
        @Html.AntiForgeryToken()

        <div class="form">
            <input id="input-email" name="Email" type="email" placeholder="Your email address" required />
            <button type="submit" id="btn-sign-up">Sign Up</button>
        </div>
    </form>
</section>