@using ZELDA.ViewModels

@{
    ViewData["Title"] = "Home";
}

@model ProductAndCategoryViewModel

<!-- hero section-->
<section id="hero" class="hero-carousel heroReveal">
    <div class="slide slide1"></div>
    <div class="slide slide2"></div>
    <div class="slide slide3"></div>

    <div class="hero-content">
        <span id="firstText" class="tagline"></span>
        <h1>Woven by Hand</h1>
        <h2>Worn by Heart</h2>
        <p>A World Where Fashion Meets Soul</p>

        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="btn-primary">Shop Now</button>
        </form>
    </div>
</section>

<!--feature section-->

<section id="product1" class="section-p1 featureProductsReveal">
    <h2>Categories</h2>
    <p>Find Your Style</p>
    <div class="pro-cotainer">
        @foreach (Category category in Model.Categories)
        {
            <div class="pro">
                @if (category.CategoryID == 1)
                {
                    <img src="../foto/clothes-f.webp" alt="">
                }
                else if (category.CategoryID == 2)
                {
                    <img src="../foto/aksesor-f.png" alt="">
                }
                else if (category.CategoryID == 3)
                {
                    <img src="../foto/bags-f.png" alt="">
                }
                <div class="des">
                    <form asp-controller="Home" asp-action="Clothes" method="get">
                        <button type="submit" class="btn-primary">
                            Go to @category.Name
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>


<!--Featured Products-->
<section id="product1" class="section-p1 featureProductsReveal">
    <h2>Featured Products</h2>
    <p>Summer Collection New Modern Designs</p>
    <div class="pro-cotainer">
        @foreach (Product product in Model.Products)
        {
            <div class="pro">
                <img src="/ProductsImages/@product.Image" alt="Product Image">
                <div class="des">
                    <h5>@product.Name</h5>

                    <div class="shopping-cart-container">
                        <h4>@product.Price €</h4>
                        <a asp-controller="Cart"
                           asp-action="AddToCart"
                           asp-route-id="product.ProductID"
                           class="cart-icon">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!--banners-->
<section id="sm-banner" class="section-p1 bannersReveal">
    <div class="banner-box">
        <h4>crazy deals</h4>
        <h2>buy 1 get 1 free</h2>
        <span> From cozy clothing to timeless bags and delicate accessories</span>
        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="white">Learn More</button>
        </form>
    </div>
    <div class="banner-box banner-box2">
        <h4>spring/summer</h4>
        <h2>upcoming season</h2>
        <span> a world where fashion meets soul ZELDA</span>
        <form asp-controller="Home" asp-action="Shop" method="get">
            <button class="white">Learn More</button>
        </form>

    </div>
</section>