@using ZELDA.ViewModels

@model ProductAndCategoryViewModel

@{
    ViewData["Title"] = "Shop";
}

<section id="page-header" class="banner-box">
    <h2>#stay home</h2>
    <p class="txt">Save more with cupons & up to 70% off!</p>
</section>

<section id="filters" class="section-p1">
    <form method="post" asp-controller="Home" asp-action="FilterProducts">
        <div class="filter-group form-group">
            <label for="category">Category:</label>
            <select class="form-control" name="category" id="category">
                <option value="">All</option>
                @foreach (Category category in Model.Categories)
                {
                    <option value="@category.CategoryID">@category.Name</option>
                }
            </select>
        </div>

        <div class="filter-group form-group">
            <label for="price">Price:</label>
            <select class="form-control" name="price" id="price">
                <option value="">All</option>
                <option value="High">High to Low</option>
                <option value="Low">Low to High</option>
            </select>
        </div>

        <div class="filter-group form-group">
            <label for="name">Name:</label>
            <input class="form-control" type="text" name="name" placeholder="Search by name" />
        </div>

        <div class="form-group">
            <label>‎ </label>
            <button class="btn-filter" type="submit">Filter</button>
        </div>
    </form>
</section>

<section id="product1" class="section-p1">
    <div class="pro-cotainer">
        @foreach (Product product in Model.Products)
        {
            <div class="pro">
                <img src="/ProductsImages/@product.Image" alt="Product Image">
                <a asp-controller="Cart"
                   asp-action="AddToCart"
                   asp-route-id="@product.ProductID"
                   class="cart-icon">
                    <i class="fa-solid fa-bag-shopping"></i>
                </a>

                <div class="des">
                    <h5>@product.Name</h5>
                    <div class="shopping-cart-container">
                        <h4>@product.Price €</h4>
                    </div>
                </div>
            </div>
        }
    </div>

</section>

<section id="newsletter" class="section-p1 newsletterReveal">
    <div class="newstext">
        <h4>Sign Up For Newsletters</h4>
        <p>Get E-mail updates about our latest shop and <span>special offers</span></p>
    </div>

    <form id="newsletter-form">
        @Html.AntiForgeryToken()

        <div class="form">
            <input id="input-email" name="Email" type="email" placeholder="Your email address" required />
            <button type="submit" id="btn-sign-up">Sign Up</button>
        </div>
    </form>
</section>