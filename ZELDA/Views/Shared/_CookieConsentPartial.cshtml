@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsentOverlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1040; backdrop-filter: blur(3px);">
        
        <div class="card shadow-lg border-0" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 500px; z-index: 1050; border-radius: 16px;">
            
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size: 3rem;">🍪</div>
                
                <h4 class="card-title font-weight-bold mb-3" style="color: #475e75;">Your privacy matters</h4>
                
                <p class="card-text text-muted mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                    We use cookies to improve your experience on our site, to analyze traffic, and to display personalized content.
                </p>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <button type="button" class="btn btn-primary btn-md px-5 font-weight-bold shadow-sm" id="btnRejectCookie">
                        Reject All
                    </button>
                    <button type="button" class="btn btn-primary btn-md px-5 font-weight-bold shadow-sm" data-cookie-string="@cookieString">
                        Accept All
                    </button>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        document.querySelector("#cookieConsentOverlay button[data-cookie-string]").addEventListener("click", function (el) {
            document.cookie = el.target.dataset.cookieString;
            mbyllBannerin();
        }, false);

        document.getElementById("btnRejectCookie").addEventListener("click", function () {
            mbyllBannerin();
        });

        function mbyllBannerin() {
            var overlay = document.getElementById("cookieConsentOverlay");
            overlay.style.transition = "opacity 0.3s ease";
            overlay.style.opacity = "0";
            setTimeout(function () {
                overlay.remove();
            }, 300);
        }
    </script>
}