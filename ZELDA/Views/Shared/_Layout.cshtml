
<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ZELDA</title>
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/selectore.css" />
    <link rel="stylesheet" href="~/css/styles.css" />
    <link rel="stylesheet" href="~/css/tableStyles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="@Url.Content("~/css/styles.css")" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glider-js@1/glider.min.css">
    <script src="https://kit.fontawesome.com/a5c6f1f7ce.js" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/scrollreveal"></script>
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
    <script src="https://code.jquery.com/jquery-4.0.0.js" integrity="sha256-9fsHeVnKBvqh3FB2HYu7g2xseAZ5MlN6Kz/qnkASV8U=" crossorigin="anonymous"></script>
</head>

<body id="body">

    <section id="hamburger">
        <a asp-action="Index" asp-controller="Home" class="logo-hamburger">
            <div class="hamburger-icon" id="hamburger-icon">&#9776;</div>
            <div>
                <img src="../foto/logo-2.png" class="logo">
            </div>
        </a>

        <div id="hamburger-menu">
            <ul class="navbar-hamburger">
                <li> <a asp-action="Index" asp-controller="">Home</a> </li>
                <li> <a asp-action="Shop" asp-controller="Home">Shop</a> </li>
                <li> <a asp-action="About" asp-controller="Home">About</a> </li>
                <li> <a asp-action="Contact" asp-controller="ContactUs">Contact</a> </li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard">
                            Admin
                        </a>
                    </li>
                }

                @if (!User.Identity.IsAuthenticated)
                {
                    <li>
                        <a asp-area="Identity" asp-page="/Account/Login">
                            <i class="fa-solid fa-user" aria-hidden="true"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li> <a asp-action="LogOut" asp-controller="Account">Log Out</a> </li>
                    <li>
                        <a asp-action="Index" asp-controller="Cart">
                            <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>

    <section id="header">
        <a asp-action="Index" asp-controller="Home"> <img src="/foto/logo-2.png" id="logo"> </a>
        <div>
            <ul class="navbar ">
                <li> <a asp-action="Index" asp-controller="">Home</a> </li>
                <li> <a asp-action="Shop" asp-controller="Home">Shop</a> </li>
                <li> <a asp-action="About" asp-controller="Home">About</a> </li>
                <li> <a asp-action="Contact" asp-controller="ContactUs">Contact</a> </li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard">
                            Admin
                        </a>
                    </li>
                }

                @if (!User.Identity.IsAuthenticated)
                {
                    <li>
                        <a asp-area="Identity" asp-page="/Account/Login">
                            <i class="fa-solid fa-user" aria-hidden="true"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li> <a asp-action="LogOut" asp-controller="Account">Log Out</a> </li>
                    <li>
                        <a asp-action="Index" asp-controller="Cart">
                            <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>

    @* <div>
        @RenderBody()
    </div> *@

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_CookieConsentPartial" />


    <footer class="section-p1">
        <div class="col">
            <h4>Contact</h4>
            <p><strong>Address:</strong> Tirane, Albania</p>
            <p><strong>Hours:</strong> 10:00-18:00, Mon-Sat</p>
        </div>

        <div class="col">
            <h4>Follow Us</h4>
            <div class="icon">
                <i class="fa-brands fa-facebook"></i>
                <i class="fa-brands fa-twitter"></i>
                <i class="fa-brands fa-instagram"></i>
                <i class="fa-brands fa-pinterest"></i>
                <i class="fa-brands fa-youtube"></i>
            </div>
        </div>

        <div class="col">
            <h4>About</h4>
            <a asp-controller="Home" asp-action="About">About Us</a>
            <a asp-controller="ContactUs" asp-action="Contact">Contact Us</a>
        </div>

        <div class="copyright">
            <p>
            <p>Copyright © ZELDA</p>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="../js/script.js"></script>
    <script src="../js/contact.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {

            $("#newsletter-form").submit(function (e) {
                e.preventDefault();

                var email = $("#input-email").val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/NewsLetters/Create',
                    type: 'POST',
                    data: {
                        Email: email,
                        __RequestVerificationToken: token
                    }
                });
            });

        });
    </script>
</body>

</html>
