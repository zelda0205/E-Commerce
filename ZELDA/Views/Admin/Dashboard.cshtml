@using ZELDA.ViewModels

@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .text-success {
        color: #198754 !important;
    }
    .text-danger {
        color: #dc3545 !important;
    }
    .admin-container {
        padding: 60px 40px 20px 40px;
    }

    .admin-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: linear-gradient(135deg, #f8f9fa, #ffffff);
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        text-align: center;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .stat-card p {
            color: #6c757d;
            margin-bottom: 5px;
        }

        .stat-card h2 {
            font-size: 2.4rem;
            font-weight: 700;
        }

    .chart-wrapper {
        background: #ffffff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.06);
        margin-bottom: 40px;
        border: 1px solid #eef2f5;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
    }

    .admin-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .admin-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 45px rgba(0,0,0,0.12);
        }

        .admin-card h3 {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .admin-card p {
            color: #6c757d;
            font-size: .95rem;
        }

    .admin-actions {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn {
        padding: 10px 14px;
        border-radius: 10px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: all .2s ease;
    }

    .primary {
        background: var(--primary-color, #008080); 
        color: #fff;
    }

        .primary:hover {
            background: #fff;
            color: var(--primary-color, #008080);
            border: 1px solid var(--primary-color, #008080);
        }

    .admin-card.border-Outline {
        border-left: 6px solid var(--primary-color, #008080);
    }
</style>

<div class="admin-container">

    <h1 class="admin-title">Admin Dashboard</h1>

    <div class="stats-grid">
        <div class="stat-card">
            <p>Total Users</p>
            <h2>@(Model.TotalNumberOfUsers == 0 ? "--" : Model.TotalNumberOfUsers.ToString())</h2>
        </div>

        <div class="stat-card">
            <p>Total Orders</p>
            <h2>@(Model.TotalNumberOfOrders == 0 ? "--" : Model.TotalNumberOfOrders.ToString())</h2>
        </div>

        <div class="stat-card">
            <p>Feedback</p>
            <h2>@(Model.TotalNumberFeedbacks == 0 ? "--" : Model.TotalNumberFeedbacks.ToString())</h2>
        </div>
        <div class="stat-card">
            <p>Total Sales</p>
            <h2 id="totalSales">--</h2>
            <div id="salesIncrease" style="font-size: 0.9rem; font-weight: 600; margin-top: 5px;"></div>
        </div>
    </div>

    <div class="admin-grid">
        <div class="admin-card border-Outline">
            <h3>Products</h3>
            <p>Add, edit or delete products</p>
            <div class="admin-actions">
                <a class="btn primary" asp-controller="Products" asp-action="Create">Add Product</a>
                <a class="btn primary" asp-controller="Products" asp-action="Index">Manage Products</a>
            </div>
        </div>

        <div class="admin-card border-Outline">
            <h3>Categories</h3>
            <p>View existing categories</p>
            <div class="admin-actions">
                <a class="btn primary" asp-controller="Categories" asp-action="Index">View Categories</a>
            </div>
        </div>

        <div class="admin-card border-Outline">
            <h3>Feedback</h3>
            <p>View or delete feedback messages</p>
            <div class="admin-actions">
                <a class="btn primary" asp-controller="ContactUs" asp-action="Index">Manage Feedbacks</a>
            </div>
        </div>

        <div class="admin-card border-Outline">
            <h3>Users</h3>
            <p>Manage registered users</p>
            <div class="admin-actions">
                <a class="btn primary" asp-action="Users" asp-controller="Admin">Manage Users</a>
            </div>
        </div>

        <div class="admin-card border-Outline">
            <h3>News Letter</h3>
            <p>Manage News Letters</p>
            <div class="admin-actions">
                <a class="btn primary" asp-action="Index" asp-controller="NewsLetters">Manage News Letters</a>
            </div>
        </div>

        <div class="admin-card border-Outline">
            <h3>Orders</h3>
            <p>Manage Orders By Clients</p>
            <div class="admin-actions">
                <a class="btn primary" asp-action="Index" asp-controller="Orders">Manage Orders</a>
            </div>
        </div>
    </div>

    <div class="chart-wrapper">
        <h3 class="fw-bold mb-4" style="font-size: 1.25rem; color: #334155;">Completed Orders by Month</h3>
        <canvas id="ordersAnalyticsChart" style="max-height: 320px; width: 100%;"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
    

        fetch('/api/adminapi/sales-stats')
        .then(res => {
        if (!res.ok) throw new Error("Gabim te sales-stats");
        return res.json();
        })
        .then(d => {

        if (d && d.total !== undefined) {
        document.getElementById('totalSales').innerText = d.total.toLocaleString() + ' €';
                
        if (d.increase !== undefined) {
        var icon = d.increase >= 0 ? '↑' : '↓';
        var color = d.increase >= 0 ? 'text-success' : 'text-danger';
        document.getElementById('salesIncrease').innerHTML =
        `<span class="${color}">${d.increase}% ${icon} compared to last month</span>`;
        }
        }
        })
        .catch(err => {
        console.error("Gabim te Sales Stats:", err);
        document.getElementById('totalSales').innerText = "0 €";
        });


        fetch('/api/adminapi/orders-by-month')
        .then(res => {
        if (!res.ok) throw new Error("Gabim te orders-by-month");
        return res.json();
        })
        .then(data => {
        if (data && data.labels && data.values) {
        const ctx = document.getElementById('ordersAnalyticsChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: data.labels,
        datasets: [{
        label: 'Number of Orders',
        data: data.values,
        backgroundColor: 'rgba(0, 128, 128, 0.2)',
        borderColor: '#008080',
        borderWidth: 2,
        borderRadius: 6
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
        });
        }
        })
        .catch(err => console.error("Gabim gjatë krijimit të grafikut:", err));
        });
    </script>
}