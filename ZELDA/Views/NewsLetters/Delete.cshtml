@model ZELDA.Models.NewsLetter

@{
    ViewData["Title"] = "Delete";
}

<div class="delete-news-letter-container">
    <h3>Are you sure you want to delete this product?</h3>
    <div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" readonly disabled class="form-control" rows="10"></input>
                </div>
                <div class="form-group">
                    <label asp-for="SubscribedAt" class="control-label"></label>
                    <input asp-for="SubscribedAt" readonly disabled class="form-control" />
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
</div>