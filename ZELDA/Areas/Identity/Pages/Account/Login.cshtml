@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="full-screen-center">
    <div class="form-card">
        <h2>Login</h2>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary w-100">Login</button>
        </form>

        <div class="text-center my-3">
            <span class="text-muted" style="background: #fff; padding: 0 10px;">OR</span>
        </div>

        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="alert alert-info text-center">
                    <small>No external authentication services configured.</small>
                </div>
            }
            else
            {
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn btn-primary w-100 mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                        Continue with @provider.DisplayName
                    </button>
                }
            }
        </form>
        <p class="mt-3 text-center mb-0">
            Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}